{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static research request",
  "type": "object",
  "required": ["question", "as_of", "mode", "sources"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "mode": {"enum": ["lookup", "explain", "analyze", "deep_research"]},
    "agent_budget": {
      "type": "object",
      "properties": {
        "max_agents": {"type": "integer", "minimum": 0},
        "max_rounds": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "location", "field_map"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["local_csv", "local_json", "http_csv", "http_json"]},
          "location": {"type": "string"},
          "provider": {"type": "string"},
          "publisher": {"type": "string"},
          "source_family": {"type": "string"},
          "evidence_grade": {"enum": ["A", "B", "C", "D"]},
          "field_map": {"type": "object"},
          "constants": {"type": "object"}
        }
      }
    }
  }
}
