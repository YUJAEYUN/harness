{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static research request",
  "type": "object",
  "required": ["question", "as_of", "mode", "sources"],
  "properties": {
    "question": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "mode": {"enum": ["lookup", "explain", "analyze", "deep_research"]},
    "allow_dynamic_collectors": {
      "type": "boolean",
      "description": "Explicit opt-in to execute agent-authored generated_* collectors."
    },
    "agent_budget": {
      "type": "object",
      "properties": {
        "max_agents": {"type": "integer", "minimum": 0},
        "max_rounds": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "field_map"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["local_csv", "local_json", "http_csv", "http_json", "generated_csv", "generated_json"]},
          "location": {"type": "string"},
          "provider": {"type": "string"},
          "publisher": {"type": "string"},
          "source_family": {"type": "string"},
          "evidence_grade": {"enum": ["A", "B", "C", "D"]},
          "field_map": {"type": "object"},
          "constants": {"type": "object"},
          "collector": {
            "type": "object",
            "required": ["command"],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "cwd": {"type": "string"},
              "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
              "env": {"type": "array", "items": {"type": "string"}},
              "code_paths": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
